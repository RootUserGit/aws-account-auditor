FROM python:3.14-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY audit-core /app/audit-core
COPY audit-data-collection /app/audit-data-collection
COPY audit-agents /app/audit-agents
COPY audit-api /app/audit-api

RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir -e /app/audit-core \
    && pip install --no-cache-dir -e /app/audit-data-collection \
    && pip install --no-cache-dir -e /app/audit-agents \
    && pip install --no-cache-dir -e /app/audit-api

ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "audit_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
